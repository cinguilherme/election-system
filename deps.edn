{:paths ["src" "resources"]
 :deps {;; d-core ecosystem libraries
        org.clojars.cinguilherme/d-core-std {:local/root "../d-core-std"}
        org.clojars.cinguilherme/d-core-db {:local/root "../d-core-db"}
        org.clojars.cinguilherme/d-core-grpc {:local/root "../d-core-grpc"}
        d-core/d-core-async-proxy {:local/root "../d-core-async-proxy"}
        org.clojars.cinguilherme/d-core-actor-system {:local/root "../d-core-actor-system"}

        ;; Clojure Core & Async
        org.clojure/clojure {:mvn/version "1.12.3"}
        org.clojure/core.async {:mvn/version "1.8.741"}

        ;; Web server & routing
        metosin/reitit {:mvn/version "0.10.0"}
        metosin/reitit-http {:mvn/version "0.10.0"}

        ;; Duct & Integrant
        org.duct-framework/main {:mvn/version "0.4.4"}
        org.duct-framework/logger {:mvn/version "0.3.0"}
        org.duct-framework/module.web {:mvn/version "0.13.4"}
        org.duct-framework/module.logging {:mvn/version "0.6.6"}

        ;; Serialization & Schema
        cheshire/cheshire {:mvn/version "5.13.0"}
        metosin/malli {:mvn/version "0.20.0"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                      :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]}
  :lint
  {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.03.13"}}
   :main-opts ["-m" "clj-kondo.main"]}}}
