    {
      "id": 12,
      "title": "Live Distributed Traces (Jaeger Trace Explorer)",
      "type": "table",
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
