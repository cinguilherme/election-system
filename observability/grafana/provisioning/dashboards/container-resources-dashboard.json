{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "CPU cores actually consumed (solid) against the cgroup CPU quota (dashed). When a solid line rides its dashed line the container is at its ceiling and will be CFS-throttled.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*quota.*" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{service!=\"\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (container_spec_cpu_quota{service!=\"\"} / container_spec_cpu_period{service!=\"\"})",
          "legendFormat": "{{service}} quota",
          "refId": "B"
        }
      ],
      "title": "CPU Usage vs Quota (cores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Fraction of CFS periods in which the container hit its CPU quota and was throttled. This is the single most valuable series for spotting a container that looks idle on application metrics but is actually CPU-starved. The async-proxy containers previously sat at 22-26%.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(container_cpu_cfs_throttled_periods_total{service!=\"\"}[1m])) / sum by (service) (rate(container_cpu_cfs_periods_total{service!=\"\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "CFS Throttling Ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Wall-clock seconds per second the container spent throttled by its CPU quota.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(container_cpu_cfs_throttled_seconds_total{service!=\"\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "CPU Throttled Time (s/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "PSI: time tasks were stalled waiting for CPU for any reason (quota, contention, or host saturation). Complements the throttling ratio when the bottleneck is the host rather than the cgroup.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(container_pressure_cpu_stalled_seconds_total{service!=\"\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "CPU Pressure Stalled (PSI)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Working set (solid) against the container memory limit (dashed). A solid line converging on its limit means the cgroup is reclaiming on every allocation.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*limit.*" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (container_memory_working_set_bytes{service!=\"\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (container_spec_memory_limit_bytes{service!=\"\"})",
          "legendFormat": "{{service}} limit",
          "refId": "B"
        }
      ],
      "title": "Memory Working Set vs Limit",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative OOM kill events per container. Any non-zero value means a service was killed by the cgroup memory limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 17 },
      "id": 6,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (container_oom_events_total{service!=\"\"})",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "OOM Events",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "PSI memory pressure: time tasks were stalled on memory reclaim. Rises before the working set actually reaches the limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 17 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(container_pressure_memory_stalled_seconds_total{service!=\"\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Memory Pressure Stalled (PSI)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Live snapshot of quota pressure across the stack, sorted worst-first. If a service sits above ~10% here, treat its CPU quota as the bottleneck before optimising application code.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 17 },
      "id": 8,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(container_cpu_cfs_throttled_periods_total{service!=\"\"}[1m])) / sum by (service) (rate(container_cpu_cfs_periods_total{service!=\"\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Current Throttling by Service",
      "type": "bargauge"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["container", "cadvisor", "throttling", "resources"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Container Resources & Throttling",
  "uid": "container-resources-throttling",
  "version": 1
}
